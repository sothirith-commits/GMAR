<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/automotive_rotary_focus_pressed_fill_color" />
            <stroke android:width="@dimen/automotive_rotary_focus_pressed_stroke_width" android:color="@color/automotive_rotary_focus_pressed_stroke_color" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/automotive_rotary_focus_fill_color" />
            <stroke android:width="@dimen/automotive_rotary_focus_stroke_width" android:color="@color/automotive_rotary_focus_stroke_color" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="?android:colorControlHighlight" />
        </shape>
    </item>
    <item>
        <ripple android:color="?android:colorControlHighlight">
            <item android:id="@android:id/mask">
                <shape android:shape="oval">
                    <solid android:color="@color/car_card_ripple_background_light" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
