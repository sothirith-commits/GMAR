<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center_vertical" android:id="@android:id/background" android:height="@dimen/car_seekbar_height">
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/car_seekbar_thumb_stroke" android:color="?android:progressBackgroundTint" />
            <corners android:radius="@dimen/car_seekbar_thumb_radius" />
        </shape>
    </item>
    <item android:gravity="center_vertical" android:id="@android:id/secondaryProgress" android:height="@dimen/car_seekbar_height">
        <clip>
            <shape android:shape="rectangle">
                <stroke android:width="@dimen/car_seekbar_thumb_stroke" android:color="?android:secondaryProgressTint" />
                <corners android:radius="@dimen/car_seekbar_thumb_radius" />
            </shape>
        </clip>
    </item>
    <item android:gravity="center_vertical" android:id="@android:id/progress" android:height="@dimen/car_seekbar_height">
        <clip>
            <shape android:shape="rectangle">
                <stroke android:width="@dimen/car_seekbar_thumb_stroke" android:color="?android:colorControlActivated" />
                <corners android:radius="@dimen/car_seekbar_thumb_radius" />
            </shape>
        </clip>
    </item>
</layer-list>
