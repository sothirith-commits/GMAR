<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="@dimen/car_account_menu_list_item_height" android:layout_marginTop="@dimen/car_account_menu_info_item_vertical_margin" android:layout_marginBottom="@dimen/car_account_menu_list_item_vertical_margin" android:paddingStart="@dimen/car_account_menu_list_item_horizontal_padding" android:paddingEnd="@dimen/car_account_menu_list_item_horizontal_padding">
