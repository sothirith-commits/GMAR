<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_window_focused="true" android:state_hovered="true">
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/car_focus_outline_stroke_width_hovered" android:color="?listItemFocusOutlineColor" />
            <solid android:color="?listItemBackgroundColor" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_window_focused="true">
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/car_focus_outline_stroke_width_focused" android:color="?listItemFocusOutlineColor" />
            <solid android:color="?listItemBackgroundColor" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?listItemBackgroundColor" />
        </shape>
    </item>
</selector>
