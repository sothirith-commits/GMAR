    d1 = {
        "\u0000\u00b0\u0001\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0000\n\u0002\u0018\u0002\n\u0000\n\u0002\u0010\u0008\n\u0002\u0008\u0004\n\u0002\u0018\u0002\n\u0000\n\u0002\u0010 \n\u0002\u0018\u0002\n\u0000\n\u0002\u0018\u0002\n\u0000\n\u0002\u0018\u0002\n\u0000\n\u0002\u0010\u000b\n\u0000\n\u0002\u0018\u0002\n\u0000\n\u0002\u0010\u0002\n\u0002\u0008\u0008\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u001f\n\u0002\u0018\u0002\n\u0002\u0008\u0002\n\u0002\u0010\u001e\n\u0002\u0008\u0005\n\u0002\u0018\u0002\n\u0002\u0008\u0008\n\u0002\u0018\u0002\n\u0002\u0008\u0005\n\u0002\u0018\u0002\n\u0002\u0008\u0012\n\u0002\u0018\u0002\n\u0002\u0008\u0005\n\u0002\u0018\u0002\n\u0002\u0008\u0006\n\u0002\u0010!\n\u0002\u0008\u0005\n\u0002\u0008\u0011\n\u0002\u0018\u0002\n\u0002\u0008\u0013\u0018\u00002\u00020\u0001:\u000c\u00a3\u0001\u00a4\u0001\u00a5\u0001\u00a6\u0001\u00a7\u0001\u00a8\u0001B1\u0008\u0007\u0012\u0006\u0010\u0003\u001a\u00020\u0002\u0012\n\u0008\u0002\u0010\u0005\u001a\u0004\u0018\u00010\u0004\u0012\u0008\u0008\u0002\u0010\u0007\u001a\u00020\u0006\u0012\u0008\u0008\u0002\u0010\u0008\u001a\u00020\u0006\u00a2\u0006\u0004\u0008\t\u0010\nJQ\u0010\u0019\u001a\u00020\u00182\u0006\u0010\u000c\u001a\u00020\u000b2\u0012\u0010\u000f\u001a\u000e\u0012\u0008\u0012\u0006\u0012\u0002\u0008\u00030\u000e\u0018\u00010\r2\u0008\u0010\u0011\u001a\u0004\u0018\u00010\u00102\u0006\u0010\u0013\u001a\u00020\u00122\u0006\u0010\u0015\u001a\u00020\u00142\n\u0008\u0002\u0010\u0017\u001a\u0004\u0018\u00010\u0016H\u0002\u00a2\u0006\u0004\u0008\u0019\u0010\u001aJ#\u0010\u001b\u001a\u00020\u00182\u0006\u0010\u0015\u001a\u00020\u00142\n\u0008\u0002\u0010\u0017\u001a\u0004\u0018\u00010\u0016H\u0002\u00a2\u0006\u0004\u0008\u001b\u0010\u001cJ#\u0010\u001d\u001a\u00020\u00182\u0006\u0010\u000c\u001a\u00020\u000b2\n\u0008\u0002\u0010\u0017\u001a\u0004\u0018\u00010\u0016H\u0002\u00a2\u0006\u0004\u0008\u001d\u0010\u001eJ\u000f\u0010\u001f\u001a\u00020\u0018H\u0002\u00a2\u0006\u0004\u0008\u001f\u0010 J\u001f\u0010#\u001a\u00020\u00182\u0006\u0010\"\u001a\u00020!2\u0006\u0010\u0015\u001a\u00020\u0014H\u0002\u00a2\u0006\u0004\u0008#\u0010$J9\u0010*\u001a\u00020\u00182\u0016\u0010(\u001a\u0012\u0012\u0004\u0012\u00020&0%j\u0008\u0012\u0004\u0012\u00020&`\'2\u0010\u0010)\u001a\u000c\u0012\u0008\u0012\u0006\u0012\u0002\u0008\u00030\u000e0\rH\u0002\u00a2\u0006\u0004\u0008*\u0010+JC\u0010,\u001a\u00020\u00182\u0016\u0010(\u001a\u0012\u0012\u0004\u0012\u00020&0%j\u0008\u0012\u0004\u0012\u00020&`\'2\u0010\u0010)\u001a\u000c\u0012\u0008\u0012\u0006\u0012\u0002\u0008\u00030\u000e0\r2\u0008\u0010\u0017\u001a\u0004\u0018\u00010\u0016H\u0002\u00a2\u0006\u0004\u0008,\u0010-Ji\u00100\u001a\u000c\u0012\u0008\u0012\u0006\u0012\u0002\u0008\u00030\u000e0\r2\u0016\u0010.\u001a\u0012\u0012\u0004\u0012\u00020&0%j\u0008\u0012\u0004\u0012\u00020&`\'2\u0016\u0010/\u001a\u0012\u0012\u0004\u0012\u00020&0%j\u0008\u0012\u0004\u0012\u00020&`\'2\u0008\u0008\u0002\u0010\u0013\u001a\u00020\u00122\u0014\u0008\u0002\u0010\u000f\u001a\u000e\u0012\u0008\u0012\u0006\u0012\u0002\u0008\u00030\u000e\u0018\u00010\rH\u0002\u00a2\u0006\u0004\u00080\u00101Jg\u00104\u001a\u0012\u0012\u0004\u0012\u00020&0%j\u0008\u0012\u0004\u0012\u00020&`\'2\u0016\u00102\u001a\u0012\u0012\u0004\u0012\u00020&0%j\u0008\u0012\u0004\u0012\u00020&`\'2\u0016\u00103\u001a\u0012\u0012\u0004\u0012\u00020&0%j\u0008\u0012\u0004\u0012\u00020&`\'2\n\u0008\u0002\u0010\u0011\u001a\u0004\u0018\u00010\u00102\n\u0008\u0002\u0010\u0013\u001a\u0004\u0018\u00010\u0012H\u0002\u00a2\u0006\u0004\u00084\u00105J\'\u00106\u001a\u00020\u00182\u0016\u0010(\u001a\u0012\u0012\u0004\u0012\u00020&0%j\u0008\u0012\u0004\u0012\u00020&`\'H\u0002\u00a2\u0006\u0004\u00086\u00107J\u000f\u00108\u001a\u00020\u0018H\u0002\u00a2\u0006\u0004\u00088\u0010 J\u0019\u0010:\u001a\u00020\u00182\u0008\u0008\u0002\u00109\u001a\u00020\u0014H\u0002\u00a2\u0006\u0004\u0008:\u0010;J)\u0010>\u001a\u00020\u00182\u0006\u0010\u000c\u001a\u00020\u000b2\u0006\u0010<\u001a\u00020\u00142\u0008\u0010=\u001a\u0004\u0018\u00010\u000bH\u0002\u00a2\u0006\u0004\u0008>\u0010?J\u0013\u0010@\u001a\u00020\u0018*\u00020&H\u0002\u00a2\u0006\u0004\u0008@\u0010AJ\'\u0010C\u001a\u00020\u00182\u0016\u0010B\u001a\u0012\u0012\u0004\u0012\u00020&0%j\u0008\u0012\u0004\u0012\u00020&`\'H\u0002\u00a2\u0006\u0004\u0008C\u00107J!\u0010D\u001a\u00020\u00182\u0006\u0010\u000c\u001a\u00020\u000b2\u0008\u0010=\u001a\u0004\u0018\u00010\u000bH\u0002\u00a2\u0006\u0004\u0008D\u0010EJ\u0013\u0010F\u001a\u00020\u0018*\u00020&H\u0002\u00a2\u0006\u0004\u0008F\u0010AJ9\u0010I\u001a\u00020\u00182\u0016\u0010B\u001a\u0012\u0012\u0004\u0012\u00020&0%j\u0008\u0012\u0004\u0012\u00020&`\'2\u0010\u0008\u0002\u0010H\u001a\n\u0012\u0004\u0012\u00020G\u0018\u00010\rH\u0002\u00a2\u0006\u0004\u0008I\u0010+J)\u0010K\u001a\u0012\u0012\u0004\u0012\u00020&0%j\u0008\u0012\u0004\u0012\u00020&`\'*\u0008\u0012\u0004\u0012\u00020&0JH\u0002\u00a2\u0006\u0004\u0008K\u0010LJ\u000f\u0010M\u001a\u00020\u0006H\u0002\u00a2\u0006\u0004\u0008M\u0010NJA\u0010S\u001a\u00020\u00182\u0006\u0010O\u001a\u00020\u000b2\u0008\u0008\u0002\u0010\u0013\u001a\u00020\u00122\u0008\u0008\u0002\u0010\u0015\u001a\u00020\u00142\n\u0008\u0002\u0010Q\u001a\u0004\u0018\u00010P2\n\u0008\u0002\u0010R\u001a\u0004\u0018\u00010P\u00a2\u0006\u0004\u0008S\u0010TJu\u0010S\u001a\u00020\u0018\"\u0008\u0008\u0000\u0010U*\u00020\u000b\"\u0008\u0008\u0001\u0010V*\u00020\u000b2\u0006\u0010W\u001a\u00028\u00002\u0006\u0010X\u001a\u00028\u00012\u0016\u0008\u0002\u0010Z\u001a\u0010\u0012\u0004\u0012\u00028\u0000\u0012\u0004\u0012\u00028\u0001\u0018\u00010Y2\u0008\u0008\u0002\u0010\u0013\u001a\u00020\u00122\u0008\u0008\u0002\u0010\u0015\u001a\u00020\u00142\n\u0008\u0002\u0010Q\u001a\u0004\u0018\u00010P2\n\u0008\u0002\u0010R\u001a\u0004\u0018\u00010P\u00a2\u0006\u0004\u0008S\u0010[J1\u0010^\u001a\u00020\u00182\u0008\u0008\u0002\u0010\u0015\u001a\u00020\u00142\n\u0008\u0002\u0010Q\u001a\u0004\u0018\u00010P2\n\u0008\u0002\u0010R\u001a\u0004\u0018\u00010PH\u0001\u00a2\u0006\u0004\u0008\\\u0010]J\u0015\u0010a\u001a\u00020\u00182\u0006\u0010`\u001a\u00020_\u00a2\u0006\u0004\u0008a\u0010bJ\u0015\u0010c\u001a\u00020\u00182\u0006\u0010`\u001a\u00020_\u00a2\u0006\u0004\u0008c\u0010bJ\u0017\u0010f\u001a\u00020\u00182\u0006\u0010O\u001a\u00020\u000bH\u0000\u00a2\u0006\u0004\u0008d\u0010eJ\u0017\u0010i\u001a\u00020\u00182\u0006\u0010g\u001a\u00020&H\u0000\u00a2\u0006\u0004\u0008h\u0010AJ\u0017\u0010k\u001a\u00020\u00182\u0006\u0010g\u001a\u00020&H\u0000\u00a2\u0006\u0004\u0008j\u0010AJ/\u0010p\u001a\u00020\u00182\u0006\u0010l\u001a\u00020\u00062\u0006\u0010m\u001a\u00020\u00062\u0006\u0010n\u001a\u00020\u00062\u0006\u0010o\u001a\u00020\u0006H\u0014\u00a2\u0006\u0004\u0008p\u0010qJ\u000f\u0010s\u001a\u00020rH\u0014\u00a2\u0006\u0004\u0008s\u0010tJ\u0017\u0010v\u001a\u00020\u00182\u0006\u0010u\u001a\u00020rH\u0014\u00a2\u0006\u0004\u0008v\u0010wR\"\u0010y\u001a\u00020x8\u0006@\u0006X\u0086\u000e\u00a2\u0006\u0012\n\u0004\u0008y\u0010z\u001a\u0004\u0008{\u0010|\"\u0004\u0008}\u0010~R,\u0010\u0080\u0001\u001a\u0008\u0012\u0004\u0012\u00020_0\u007f8\u0006X\u0087\u0004\u00a2\u0006\u0017\n\u0006\u0008\u0080\u0001\u0010\u0081\u0001\u0012\u0005\u0008\u0084\u0001\u0010 \u001a\u0006\u0008\u0082\u0001\u0010\u0083\u0001R*\u0010\u0086\u0001\u001a\u00030\u0085\u00018\u0006@\u0006X\u0086\u000e\u00a2\u0006\u0018\n\u0006\u0008\u0086\u0001\u0010\u0087\u0001\u001a\u0006\u0008\u0088\u0001\u0010\u0089\u0001\"\u0006\u0008\u008a\u0001\u0010\u008b\u0001R*\u0010\u008d\u0001\u001a\u00020\u000b2\u0007\u0010\u008c\u0001\u001a\u00020\u000b8\u0006@BX\u0086\u000e\u00a2\u0006\u0010\n\u0006\u0008\u008d\u0001\u0010\u008e\u0001\u001a\u0006\u0008\u008f\u0001\u0010\u0090\u0001R\'\u0010.\u001a\u0012\u0012\u0004\u0012\u00020&0%j\u0008\u0012\u0004\u0012\u00020&`\'8\u0002@\u0002X\u0082\u000e\u00a2\u0006\u0007\n\u0005\u0008.\u0010\u0091\u0001R)\u0010\u0092\u0001\u001a\u0012\u0012\u0004\u0012\u00020&0%j\u0008\u0012\u0004\u0012\u00020&`\'8\u0002@\u0002X\u0082\u000e\u00a2\u0006\u0008\n\u0006\u0008\u0092\u0001\u0010\u0091\u0001R\u0019\u0010=\u001a\u0004\u0018\u00010\u000b8\u0002@\u0002X\u0082\u000e\u00a2\u0006\u0007\n\u0005\u0008=\u0010\u008e\u0001RA\u0010\u0093\u0001\u001a\n\u0012\u0004\u0012\u00020G\u0018\u00010\r2\u000f\u0010\u008c\u0001\u001a\n\u0012\u0004\u0012\u00020G\u0018\u00010\r8\u0000@BX\u0081\u000e\u00a2\u0006\u0017\n\u0006\u0008\u0093\u0001\u0010\u0081\u0001\u0012\u0005\u0008\u0095\u0001\u0010 \u001a\u0006\u0008\u0094\u0001\u0010\u0083\u0001R\u001c\u0010\u0097\u0001\u001a\u0005\u0018\u00010\u0096\u00018\u0002@\u0002X\u0082\u000e\u00a2\u0006\u0008\n\u0006\u0008\u0097\u0001\u0010\u0098\u0001R\u001c\u0010\u0099\u0001\u001a\u0005\u0018\u00010\u0096\u00018\u0002@\u0002X\u0082\u000e\u00a2\u0006\u0008\n\u0006\u0008\u0099\u0001\u0010\u0098\u0001R\u001b\u0010\u009a\u0001\u001a\u0004\u0018\u00010\u00168\u0002@\u0002X\u0082\u000e\u00a2\u0006\u0008\n\u0006\u0008\u009a\u0001\u0010\u009b\u0001R\u0019\u0010\u009c\u0001\u001a\u00020\u00148\u0002@\u0002X\u0082\u000e\u00a2\u0006\u0008\n\u0006\u0008\u009c\u0001\u0010\u009d\u0001R\u0019\u0010\u009e\u0001\u001a\u00020\u00068\u0002@\u0002X\u0082\u000e\u00a2\u0006\u0008\n\u0006\u0008\u009e\u0001\u0010\u009f\u0001R\u0019\u0010B\u001a\u0008\u0012\u0004\u0012\u00020&0\r8F\u00a2\u0006\u0008\u001a\u0006\u0008\u00a0\u0001\u0010\u0083\u0001R\u0014\u0010\u00a1\u0001\u001a\u00020\u00148F\u00a2\u0006\u0008\u001a\u0006\u0008\u00a1\u0001\u0010\u00a2\u0001\u00a8\u0006\u00a9\u0001"
