<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:startColor="#00ffffff" android:endColor="#00000000" android:angle="0.0" android:type="radial" android:centerY="1.0" android:gradientRadius="3.5dp" android:centerColor="#1a000000" />
            <corners android:topLeftRadius="100.0dp" android:topRightRadius="100.0dp" />
            <size android:height="3.5dp" android:width="3.5dp" />
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient android:startColor="#00ffffff" android:endColor="#00000000" android:angle="0.0" android:type="radial" android:centerY="0.0" android:gradientRadius="3.5dp" android:centerColor="#1a000000" />
            <corners android:bottomLeftRadius="100.0dp" android:bottomRightRadius="100.0dp" />
            <size android:height="3.5dp" android:width="3.5dp" />
        </shape>
    </item>
    <item android:gravity="left" android:top="3.5dp" android:bottom="3.5dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#00ffffff" android:endColor="#1a000000" android:angle="0.0" />
            <size android:height="193.0dp" android:width="2.0dp" />
        </shape>
    </item>
    <item android:gravity="right" android:left="4.5dp" android:top="3.5dp" android:bottom="3.5dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#00ffffff" android:endColor="#1a000000" android:angle="180.0" />
            <size android:height="193.0dp" android:width="2.0dp" />
        </shape>
    </item>
    <item android:left="2.0dp" android:top="2.0dp" android:right="2.0dp" android:bottom="2.0dp">
        <shape android:shape="rectangle">
            <solid android:color="#99ffffff" />
            <corners android:radius="100.0dp" />
            <size android:height="200.0dp" android:width="3.0dp" />
        </shape>
    </item>
</layer-list>
