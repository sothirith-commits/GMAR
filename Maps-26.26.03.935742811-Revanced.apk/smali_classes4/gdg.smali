.class public Lgdg;
.super Lgdf;
.source "PG"


# direct methods
.method public constructor <init>()V
    .locals 0

    invoke-direct {p0}, Lgdf;-><init>()V

    return-void
.end method

.method public constructor <init>(Lgdw;)V
    .locals 0

    invoke-direct {p0, p1}, Lgdf;-><init>(Lgdw;)V

    return-void
.end method
